# Relay local configuration.
#
# `make setup` copies this file to .env and replaces every __GENERATE__ value
# with a random secret. .env is git-ignored. Never commit real values, and
# never put production credentials here: in the cloud these come from Secret
# Manager (see docs/deployment/).

# --- runtime ---------------------------------------------------------------
RELAY_ENV=local
RELAY_LOG_LEVEL=INFO
RELAY_LOG_FORMAT=console
RELAY_DATABASE_URL=postgresql+psycopg://relay@127.0.0.1:54329/relay
RELAY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- messaging (local = PostgreSQL-backed dev queue; no cloud account needed) --
RELAY_QUEUE_BACKEND=local
RELAY_WORKER_BASE_URL=http://127.0.0.1:8001
RELAY_BACKGROUND_LOOPS=true
RELAY_INTERNAL_TOKEN=__GENERATE__

# --- demo source and destination -------------------------------------------
RELAY_DEMO_DESTINATION_BASE_URL=http://127.0.0.1:8000
RELAY_SECRET_DEMO_WEBHOOK=__GENERATE__
RELAY_SECRET_DEMO_DESTINATION_TOKEN=__GENERATE__

# --- seed accounts (used only by `make seed`) --------------------------------
RELAY_SEED_ADMIN_EMAIL=admin@relay.local
RELAY_SEED_ADMIN_PASSWORD=__GENERATE__
RELAY_SEED_OPERATOR_EMAIL=operator@relay.local
RELAY_SEED_OPERATOR_PASSWORD=__GENERATE__
RELAY_SEED_VIEWER_EMAIL=viewer@relay.local
RELAY_SEED_VIEWER_PASSWORD=__GENERATE__

# --- destination safety overrides (development only; rejected when RELAY_ENV=cloud)
# Exact host:port entries that may resolve to private addresses, e.g. a local mock API.
# RELAY_DESTINATION_ALLOW_PRIVATE_HOSTS=localhost:9000

# --- AI investigation (optional) -------------------------------------------
# Leave unset to use the deterministic, model-free diagnosis. Providers are tried
# in order; any failure falls back to the next, then to the deterministic path.
# RELAY_AI_PROVIDERS=ollama
# RELAY_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# RELAY_AI_OLLAMA_MODEL=llama3.1
#
# Hosted providers cost money per request. Off unless you add a key.
# RELAY_AI_PROVIDERS=ollama,anthropic
# RELAY_AI_ANTHROPIC_API_KEY=
# RELAY_AI_ANTHROPIC_MODEL=claude-opus-5-5
# RELAY_AI_OPENAI_COMPAT_BASE_URL=
# RELAY_AI_OPENAI_COMPAT_API_KEY=
# RELAY_AI_OPENAI_COMPAT_MODEL=

# --- MCP server (optional; `make mcp`) ---------------------------------------
# RELAY_MCP_WORKSPACE_ID=
